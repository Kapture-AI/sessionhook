{
  "name": "sessionhook",
  "version": "0.1.0",
  "description": "Deliver Jira comments and webhook events to running Claude Code sessions",
  "keywords": [
    "claude-code",
    "jira",
    "webhook",
    "mcp",
    "channels",
    "events"
  ],
  "homepage": "https://github.com/Kapture-AI/sessionhook#readme",
  "bugs": {
    "url": "https://github.com/Kapture-AI/sessionhook/issues"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kapture-AI/sessionhook.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "sessionhook": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}
